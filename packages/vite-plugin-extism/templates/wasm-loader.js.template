// Generic WASM loader script for any TypeScript project
import { createPlugin } from '@extism/extism'

class {{ADAPTER_CLASS_NAME}} {
  constructor() {
    this.plugin = null
    this.isInitialized = false
    
    // Wait for DOM to be ready before initializing WASM
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        this.loadWASMPlugin()
        this.initializeUI()
      })
    } else {
      // DOM is already ready
      this.loadWASMPlugin()
      this.initializeUI()
    }
  }

  async loadWASMPlugin() {
    try {
      console.log('📦 Loading WASM plugin...')
      
      // Load the manifest file
      const manifestResponse = await fetch('./manifest.json')
      const manifest = await manifestResponse.json()
      
      // Create plugin with proper host functions for DOM manipulation
      this.plugin = await createPlugin(manifest, {
        useWasi: true,
        functions: {
          "extism:host/user": {
            console_log(callContext, messagePtr, messageLen) {
              try {
                // Read string using Extism SDK's proper memory reading
                const memory = callContext.read(messagePtr)
                const message = memory.text()
                
                console.log('🔧 WASM:', message)
                
                // Also display in page console area if available
                const consoleArea = document.getElementById('console-output')
                if (consoleArea) {
                  consoleArea.innerHTML += `<div>🔧 WASM: ${message}</div>`
                }
              } catch (error) {
                console.log('🔧 WASM console_log error:', error.message, 'ptr:', messagePtr, 'len:', messageLen)
              }
            },
            
            // DOM element access
            dom_get_element_by_id(callContext, idPtr, idLen) {
              try {
                // Read string using Extism SDK's proper memory reading
                const memory = callContext.read(idPtr)
                const elementId = memory.text()
                
                console.log(`🔍 Looking for element: "${elementId}"`)
                console.log(`🔍 Document ready state: ${document.readyState}`)
                console.log(`🔍 All elements in DOM:`, Array.from(document.querySelectorAll('*')).map(el => el.id).filter(id => id))
                
                const element = document.getElementById(elementId)
                console.log(`🔍 Element found:`, element ? 'FOUND' : 'NOT FOUND')
                
                if (!element) {
                // Try a small delay and retry once
                setTimeout(() => {
                  const retryElement = document.getElementById(elementId)
                  console.log(`🔄 Retry element "${elementId}":`, retryElement ? 'FOUND' : 'STILL NOT FOUND')
                }, 100)
              }
              
                
                return element ? 1 : 0
              } catch (error) {
                console.log('🔍 DOM get_element_by_id error:', error.message, 'ptr:', idPtr, 'len:', idLen)
                return 0
              }
            },
            
            // Text content setting
            dom_set_text_content(callContext, elementIdPtr, elementIdLen, textPtr, textLen) {
              try {
                // Read strings using Extism SDK's proper memory reading
                const elementIdMemory = callContext.read(elementIdPtr)
                const elementId = elementIdMemory.text()
                
                const textMemory = callContext.read(textPtr)
                const text = textMemory.text()
                
                const element = document.getElementById(elementId)
                
                console.log(`🎯 Setting text for element: ${elementId} = "${text}"`)
                
                if (element) {
                  element.textContent = text
                  console.log(`✅ Text set successfully for element: ${elementId}`)
                  return 1 // Success
                } else {
                  console.log(`❌ Element not found: ${elementId}`)
                  return 0 // Failure
                }
              } catch (error) {
                console.log('🎯 DOM set_text_content error:', error.message)
                return 0
              }
            },
            
            // Element creation
            dom_create_element(callContext, tagPtr, tagLen, idPtr, idLen) {
              try {
                // Read strings using Extism SDK's proper memory reading
                const tagMemory = callContext.read(tagPtr)
                const tag = tagMemory.text()
                
                const idMemory = callContext.read(idPtr)
                const id = idMemory.text()
                
                const element = document.createElement(tag)
                element.id = id
                document.body.appendChild(element)
                
                console.log(`🔧 Created element: <${tag} id="${id}">`)
                return 1 // Success
              } catch (error) {
                console.log('🔧 DOM create_element error:', error.message)
                return 0
              }
            },
            
            // Fetch API
            fetch_request(callContext, urlPtr, urlLen, methodPtr, methodLen) {
              try {
                // Read strings using Extism SDK's proper memory reading
                const urlMemory = callContext.read(urlPtr)
                const url = urlMemory.text()
                
                const methodMemory = callContext.read(methodPtr)
                const method = methodMemory.text()
                
                console.log(`🌐 Fetch request: ${method} ${url}`)
                
                fetch(url, { method })
                  .then(response => response.text())
                  .then(data => {
                    console.log(`✅ Fetch response:`, data.substring(0, 100))
                    // Store response for WASM to read later
                    const responseBytes = new TextEncoder().encode(data)
                    callContext.store(responseBytes)
                  })
                  .catch(error => {
                    console.log(`❌ Fetch error:`, error.message)
                    const errorBytes = new TextEncoder().encode(error.message)
                    callContext.store(errorBytes)
                  })
                
                return 1
              } catch (error) {
                console.log('🌐 Fetch setup error:', error.message)
                return 0
              }
            },

            // Event listener setup
            dom_add_event_listener(callContext, elementIdPtr, elementIdLen, eventPtr, eventLen, handlerPtr, handlerLen) {
              try {
                // Read strings using Extism SDK's proper memory reading
                const elementIdMemory = callContext.read(elementIdPtr)
                const elementId = elementIdMemory.text()
                
                const eventMemory = callContext.read(eventPtr)
                const eventType = eventMemory.text()
                
                const handlerMemory = callContext.read(handlerPtr)
                const handlerName = handlerMemory.text()
                
                const element = document.getElementById(elementId)
                
                console.log(`🎪 Adding ${eventType} listener to ${elementId} -> ${handlerName}`)
                
                if (element) {
                  element.addEventListener(eventType, async () => {
                    console.log(`🖱️ ${eventType} triggered, calling ${handlerName}`)
                    try {
                      const result = await this.plugin.call(handlerName, new TextEncoder().encode(''))
                      if (result) {
                        const output = new TextDecoder().decode(result.buffer)
                        console.log(`✅ Handler result:`, output)
                      }
                    } catch (error) {
                      console.log(`❌ WASM handler error:`, error.message)
                    }
                  })
                  return 1
                }
                return 0
              } catch (error) {
                console.log('🎪 DOM add_event_listener error:', error.message)
                return 0
              }
            },
            
            // Input value getter
            dom_get_input_value(callContext, elementIdOffset) {
              try {
                const elementId = callContext.read(elementIdOffset).text()
                const element = document.getElementById(elementId)
                if (element && (element.tagName === 'INPUT' || element.tagName === 'TEXTAREA')) {
                  const value = element.value
                  console.log(`📝 Got input value from ${elementId}: "${value}"`)
                  // Store the value for WASM to read
                  const valueBytes = new TextEncoder().encode(value)
                  return callContext.store(valueBytes)
                }
                return 0
              } catch (error) {
                console.log('📝 DOM get_input_value error:', error.message)
                return 0
              }
            }

            {{DETECTED_HOST_FUNCTIONS}}
          }
        }
      })
      
      // Initialize the WASM module
      try {
        const pluginExports = await this.plugin.getExports()
        console.log(`pluginExports: ${JSON.stringify(pluginExports, null, 2)}`)
        const pluginImports = await this.plugin.getImports()
        console.log(`pluginImports: ${JSON.stringify(pluginImports, null, 2)}`)
        
        const result = await this.plugin.call('main')  // No input needed for main function
        console.log('✅ WASM main function completed, result:', result)
      } catch (error) {
        console.log('⚠️  No main function found or error:', error.message)
        console.log('⚠️  Error details:', error)
      }
      
      this.isInitialized = true
      console.log('✅ WASM plugin loaded successfully!')
      
    } catch (error) {
      console.error('❌ Failed to load WASM plugin:', error)
    }
  }

  // Helper method for calling WASM functions with proper input/output handling
  async callWasmFunction(funcName, input = '') {
    if (!this.plugin || !this.isInitialized) {
      throw new Error('WASM plugin not initialized')
    }
    
    try {
      const result = await this.plugin.call(funcName, new TextEncoder().encode(input))
      if (result) {
        return new TextDecoder().decode(result.buffer)
      }
      return ''
    } catch (error) {
      console.error(`❌ Error calling WASM function ${funcName}:`, error.message)
      throw error
    }
  }

  initializeUI() {
    // Setup UI when DOM is ready
    document.addEventListener('DOMContentLoaded', () => {
      console.log('🌐 {{ADAPTER_CLASS_NAME}} initialized')
      
      // Setup specific button handlers
      const testButton = document.getElementById('test-button')
      if (testButton) {
        testButton.addEventListener('click', async () => {
          console.log('🖱️ Test button clicked, calling WASM handleButtonClick...')
          try {
            const result = await this.plugin.call('handleButtonClick')
            console.log('✅ Button click completed')
          } catch (error) {
            console.log('❌ WASM button handler error:', error.message)
          }
        })
      }

      // Setup DOM test button (directly manipulates DOM without WASM)
      const domTestButton = document.getElementById('dom-test')
      const outputArea = document.getElementById('output-area')
      if (domTestButton && outputArea) {
        domTestButton.addEventListener('click', () => {
          outputArea.textContent = `DOM Updated at ${new Date().toLocaleTimeString()}`
          console.log('✅ DOM manipulation completed')
        })
      }
      
      // Setup text processing (processUserInput WASM function)
      const processTextButton = document.getElementById('process-text')
      const textInput = document.getElementById('text-input')
      if (processTextButton && textInput && outputArea) {
        processTextButton.addEventListener('click', async () => {
          const inputText = textInput.value
          console.log('🔤 Processing text:', inputText)
          try {
            const result = await this.callWasmFunction('processUserInput', inputText)
            outputArea.textContent = `Processed: "${result}"`
            console.log('✅ Text processing completed:', result)
          } catch (error) {
            console.log('❌ WASM text processing error:', error.message)
            outputArea.textContent = `Error: ${error.message}`
          }
        })
      }
    })
  }
}

// Initialize the WASM adapter when the page loads
window.addEventListener('load', () => {
  new {{ADAPTER_CLASS_NAME}}()
})
