{
  "name": "extism-plugin-example",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist && mkdir -p dist",
    "clean-wasm": "rm -rf dist && mkdir -p dist",
    "dev": "vite",
    "build": "vite build",
    "build:wasm": "npm run clean-wasm && npm run clean && vite build --config vite.config.wasm.ts",
    "preview": "vite preview",
    "preview:wasm": "vite preview  --config vite.config.wasm.ts",
    "build:all": "npm run build && npm run build:wasm",
    "serve:all": "npx concurrently \"npm run preview\" \"npm run preview:wasm\"",
    "test": "cd e2e && npm test",
    "test:debug": "cd e2e && npm run test:debug",
    "test:ui": "cd e2e && npm run test:ui",
    "test:install": "cd e2e && npm run install"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vite-plugin-extism": "workspace:*"
  },
  "dependencies": {
    "@extism/extism": "^2.0.0-rc13"
  }
}
